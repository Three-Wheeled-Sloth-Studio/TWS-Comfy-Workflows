ed as supplied."],"widgets_values_named":{"text":"Automatic duration is calculated from the loaded audio."},"title":"How this version works","color":"#223","bgcolor":"#335"},{"id":207,"type":"PrimitiveFloat","pos":[420,1350],"size":[300,82],"flags":{},"order":12,"mode":0,"inputs":[{"localized_name":"value","name":"value","type":"FLOAT","link":null,"widget":{"name":"value"}}],"outputs":[{"localized_name":"FLOAT","name":"FLOAT","type":"FLOAT","links":[606,611],"slot_index":0}],"properties":{"Node name for S&R":"PrimitiveFloat","cnr_id":"comfy-core","ver":"0.3.54"},"widgets_values":[16.0],"widgets_values_named":{"value":16.0},"title":"FPS"},{"id":208,"type":"WanS2VStateStart","pos":[1450,30],"size":[290,70],"flags":{},"order":44,"mode":0,"inputs":[{"localized_name":"initial_latent","name":"initial_latent","type":"LATENT","link":638},{"localized_name":"initial_positive","name":"initial_positive","type":"CONDITIONING","link":639}],"outputs":[{"localized_name":"state","name":"state","type":"WAN_S2V_STATE","slot_index":0,"links":[640]}],"properties":{"Node name for S&R":"WanS2VStateStart"},"widgets_values":[],"title":"Move initial chunk to CPU"},{"id":209,"type":"WanS2VStateToLatent","pos":[2780,30],"size":[270,70],"flags":{},"order":51,"mode":0,"inputs":[{"localized_name":"state","name":"state","type":"WAN_S2V_STATE","link":661}],"outputs":[{"localized_name":"latent","name":"latent","type":"LATENT","slot_index":0,"links":[662,663]}],"properties":{"Node name for S&R":"WanS2VStateToLatent"},"widgets_values":[],"title":"Combine CPU chunks once at end"},{"id":210,"type":"MarkdownNote","pos":[1450,760],"size":[620,210],"flags":{},"order":13,"mode":0,"inputs":[],"outputs":[],"properties":{},"widgets_values":["## Constant-memory continuation loop\n\nEach completed latent chunk is moved to system RAM. Only the last 19 latent frames are supplied as motion context to the next Wan pass. This matches the core Wan extension implementation while avoiding progressively cached GPU concatenations. The reference-image latent is reused from the initial pass, so the VAE is not reloaded between every Wan iteration. All CPU chunks are concatenated once after the loop."],"widgets_values_named":{"text":"Constant-memory Wan continuation."},"title":"Why this version avoids late-loop OOM","color":"#232","bgcolor":"#353"}],"links":[[74,38,0,6,0,"CLIP"],[75,38,0,7,0,"CLIP"],[111,54,0,3,0,"MODEL"],[120,57,0,56,0,"AUDIO_ENCODER"],[121,58,0,56,1,"AUDIO"],[198,58,0,82,1,"AUDIO"],[252,52,0,93,4,"IMAGE"],[253,56,0,93,3,"AUDIO_ENCODER_OUTPUT"],[254,6,0,93,0,"CONDITIONING"],[255,7,0,93,1,"CONDITIONING"],[257,93,0,3,1,"CONDITIONING"],[258,93,1,3,2,"CONDITIONING"],[259,93,2,3,3,"LATENT"],[269,94,0,95,0,"LATENT"],[273,96,0,82,0,"IMAGE"],[281,39,0,93,2,"VAE"],[362,37,0,107,0,"MODEL"],[363,107,0,54,0,"MODEL"],[335,104,0,93,9,"INT"],[319,103,0,3,5,"INT"],[348,105,0,3,6,"FLOAT"],[364,82,0,113,0,"VIDEO"],[605,58,0,197,0,"AUDIO"],[606,207,0,197,1,"FLOAT"],[607,104,0,197,2,"INT"],[608,197,1,96,2,"INT"],[609,197,2,96,1,"INT"],[611,207,0,82,2,"FLOAT"],[635,95,0,205,0,"LATENT"],[636,39,0,205,1,"VAE"],[637,205,0,96,0,"IMAGE"],[638,3,0,208,0,"LATENT"],[639,93,0,208,1,"CONDITIONING"],[640,208,0,198,1,"WAN_S2V_STATE"],[641,197,3,198,2,"INT"],[642,198,4,201,4,"WAN_S2V_STATE"],[643,198,4,203,0,"WAN_S2V_STATE"],[644,6,0,201,0,"CONDITIONING"],[645,7,0,201,1,"CONDITIONING"],[646,39,0,201,2,"VAE"],[647,104,0,201,3,"INT"],[648,56,0,201,5,"AUDIO_ENCODER_OUTPUT"],[649,54,0,202,0,"MODEL"],[650,201,0,202,1,"CONDITIONING"],[651,201,1,202,2,"CONDITIONING"],[652,201,2,202,3,"LATENT"],[653,198,0,199,0,"INT"],[654,200,0,199,1,"INT"],[655,199,1,202,4,"INT"],[656,103,0,202,5,"INT"],[657,105,0,202,6,"FLOAT"],[658,202,0,203,1,"LATENT"],[659,203,0,204,0,"WAN_S2V_STATE"],[660,203,0,204,1,"WAN_S2V_STATE"],[661,204,0,209,0,"WAN_S2V_STATE"],[662,209,0,94,0,"LATENT"],[663,209,0,95,1,"LATENT"]],"groups":[{"id":1,"title":"Fix overbaked first frame","bounding":[2430,80,610,450],"color":"#3f789e","flags":{}},{"id":