{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tws.local/schemas/infra-choir-target-v2.json",
  "title": "Infra Choir animation target",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version", "target_id", "object_name", "animation_prompt", "enabled",
    "mask_verified", "target_role", "envelope_group", "audio_driver",
    "motion_source", "motion_type", "on_beat_flicker", "off_beat_flicker",
    "on_beat_motion", "off_beat_motion", "generated_motion_strength",
    "max_luminance_change", "glow_strength", "glow_radius_px",
    "saturation_variation", "hue_variation_degrees"
  ],
  "properties": {
    "version": {"enum": [1, 2]},
    "target_id": {"type": "string", "minLength": 1},
    "object_name": {"type": "string"},
    "animation_prompt": {"type": "string"},
    "enabled": {"type": "boolean"},
    "mask_verified": {"type": "boolean"},
    "target_role": {"enum": ["organic", "light_source", "illumination", "reflection"]},
    "envelope_group": {"type": "string", "minLength": 1},
    "audio_driver": {"enum": ["beat", "slow", "energy", "low", "mid", "high", "kick", "snare", "hihat", "onset", "beat_phase", "phrase", "vocal_energy", "instrument_energy"]},
    "motion_source": {"enum": ["procedural", "generated_clip", "generated_then_procedural"]},
    "motion_type": {"enum": ["billow", "sway", "drift", "still"]},
    "on_beat_flicker": {"type": "number", "minimum": 0, "maximum": 2},
    "off_beat_flicker": {"type": "number", "minimum": 0, "maximum": 2},
    "on_beat_motion": {"type": "number", "minimum": 0, "maximum": 2},
    "off_beat_motion": {"type": "number", "minimum": 0, "maximum": 2},
    "generated_motion_strength": {"type": "number", "minimum": 0, "maximum": 1},
    "max_luminance_change": {"type": "number", "minimum": 0, "maximum": 0.5},
    "glow_strength": {"type": "number", "minimum": 0, "maximum": 1},
    "glow_radius_px": {"type": "number", "minimum": 0, "maximum": 160},
    "saturation_variation": {"type": "number", "minimum": -0.5, "maximum": 0.5},
    "hue_variation_degrees": {"type": "number", "minimum": -30, "maximum": 30},
    "secondary_audio_driver": {"enum": ["none", "beat", "slow", "energy", "low", "mid", "high", "kick", "snare", "hihat", "onset", "beat_phase", "phrase", "vocal_energy", "instrument_energy"]},
    "secondary_driver_mix": {"type": "number", "minimum": 0, "maximum": 1},
    "response_attack_ms": {"type": "number", "minimum": 0},
    "response_decay_ms": {"type": "number", "minimum": 0},
    "response_hold_ms": {"type": "number", "minimum": 0},
    "response_sustain": {"type": "number", "minimum": 0, "maximum": 1},
    "response_release_ms": {"type": "number", "minimum": 0},
    "response_smoothing": {"type": "number", "minimum": 0, "maximum": 0.98},
    "response_min": {"type": "number", "minimum": 0, "maximum": 1},
    "response_max": {"type": "number", "minimum": 0, "maximum": 1},
    "response_sensitivity": {"type": "number", "minimum": 0, "maximum": 3},
    "response_curve": {"type": "number", "minimum": 0.2, "maximum": 4},
    "rhythmic_subdivision": {"enum": [1, 2, 4]},
    "accent_weight": {"type": "number", "minimum": 0, "maximum": 1},
    "group_gain": {"type": "number", "minimum": 0, "maximum": 2},
    "group_delay_ms": {"type": "number", "minimum": -1000, "maximum": 2000},
    "lighting_gain": {"type": "number", "minimum": 0, "maximum": 3},
    "edge_glow_enabled": {"type": "boolean"},
    "edge_glow_amount": {"type": "number", "minimum": 0, "maximum": 1},
    "shimmer_enabled": {"type": "boolean"},
    "shimmer_amount": {"type": "number", "minimum": 0, "maximum": 1},
    "section_response": {"type": "number", "minimum": 0, "maximum": 1},
    "atmospheric_motion_mode": {"enum": ["auto", "procedural", "cached_clip", "cached_clip_then_procedural"]},
    "atmospheric_expansion_percent": {"type": "number", "minimum": 0, "maximum": 50},
    "generated_clip_path": {"type": "string"},
    "generated_clip_max_seconds": {"type": "number", "minimum": 0.25, "maximum": 10},
    "generated_clip_overlap_seconds": {"type": "number", "minimum": 0, "maximum": 3},
    "smoke_effect_strength": {"type": "number", "minimum": 0, "maximum": 3},
    "foreground_protection": {"type": "boolean"}
  },
  "description": "Version 1 is the original production target. Version 2 adds optional frame-aligned musical drivers, ADSHR shaping, group delay/gain, and bounded effect switches. Mask pixels and optional generated IMAGE batches remain ComfyUI connections."
}
